@model RekeningViewModel
@{
    ViewData["Title"] = "Huuren";
}

<h1>Afrekenen</h1>

<table class="rekening-Tabel">
    <thead>
        <tr>
            <th>Titel</th>
            <th>Prijs</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var film in Model.Films)
        {
            <tr>
                <td>@film.Titel</td>
                <td>€ @film.Prijs</td>
            </tr>


        }
        <tr>
            <td><strong>Totaal</strong></td>
            <td><strong>€ @Model.TotaalPrijs</strong></td>
    </tbody>
</table>
<br />
<div>Word gefacteerd aan:</div>
<br />
<p>@Model.Naam</p>
<p>@Model.Adres</p>
<p>@Model.Gemeente</p>

<br />
<br />
<!--uiloggen-->
<a asp-action="Logout"><button class="btn btn-primary">uitloggen</button></a>

