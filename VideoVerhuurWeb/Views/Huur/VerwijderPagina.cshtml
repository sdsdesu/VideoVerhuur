@model VerwijderenViewModel
@{
    ViewData["Title"] = "VerwijderPagina";
}

<h1>Verwijder gehuurde film</h1>
<p>"<strong>@Model.Title</strong>" verwijderen van jouw winkelmandje</p>
<form asp-action="Verwijderen" method="post">
    <input type="hidden" asp-for="Id" value="@Model.Id" />
    <input type="hidden" asp-for="Title" value="@Model.Title" />
    <button type="submit" class="btn btn-danger">JA</button>
    <button type="button" class="btn btn-primary" onclick="window.history.back();">NEEN</button>
</form>


