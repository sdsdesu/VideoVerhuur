@model IEnumerable<Film>
@{
    ViewData["Title"] = "Winkelmand";
}

<h1>Winkelmandje</h1>

<table class="table">
    <thead>
        <tr>
            <th>Titel</th>
            <th>Prijs</th>
            <th>Verwijderen</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var film in Model)
        {
            <tr>
                <td>@film.Titel</td>
                <td>@film.Prijs</td>
                <td>

                    <a asp-action="VerwijderPagina" asp-route-id="@film.FilmId">
                        <img class="kleinSymbool" src="~/Images/delete.png" alt="UitMantje halen" />
                    </a>

                </td>
            </tr>
        }

</table>
<a asp-action="Index"><button class="btn btn-primary">Verder winkelen</button></a>
<a asp-action="Huuren"><button class="btn btn-primary">Afrekenen</button></a>
