@model SelecteerFilmViewModel
@{
    ViewData["Title"] = "Films";
}

<h1>@Model.Genre</h1>

<table class="table">
    <thead>
        <tr>
            <th>Titel</th>
            <th>Prijs</th>
            <th>In voorraad</th>
            <th>Huren</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var film in Model.Films)
        {
            <tr>
                <td>@film.Titel</td>
                <td>@film.Prijs</td>
                <td>@film.InVoorraad</td>
                <td>

                    @if (film.InVoorraad > 0)
                    {
                        <a asp-action="Huren" asp-route-id="@film.FilmId">
                            <img class="kleinSymbool" src="~/Images/plus.png" alt="Huur Film" />
                        </a>
                    }

                </td>



            </tr>
        }
    </tbody>
</table>
